# Contact and rental forms send email through Resend (https://resend.com).
# Without these two values the forms show "We couldn't send your message" with the phone and email instead.
RESEND_API_KEY=
# One or more addresses, comma separated, that receive form messages.
CONTACT_TO_EMAIL=sales@cvdynamics.com.ph
# Sender. Must be on a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL="C&V Dynamics website <website@cvdynamics.com.ph>"
